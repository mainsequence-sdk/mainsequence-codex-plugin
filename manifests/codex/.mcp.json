{
  "mcpServers": {
    "mainsequence": {
      "command": "node",
      "args": [
        "./dist/panel-server.js"
      ],
      "cwd": ".",
      "env_vars": [
        "DBUS_SESSION_BUS_ADDRESS",
        "XDG_RUNTIME_DIR",
        "DISPLAY",
        "WAYLAND_DISPLAY",
        "MAINSEQUENCE_ENDPOINT",
        "MAINSEQUENCE_ACCESS_TOKEN",
        "MAINSEQUENCE_REFRESH_TOKEN"
      ],
      "tool_timeout_sec": 300
    }
  }
}
